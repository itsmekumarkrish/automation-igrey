{
  "version": "7.3",
  "screens": [
    {
      "id": "HOW_IT_WORKS_SCREEN",
      "title": "How Smart Stay Works",
      "terminal": false,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "How SMART STAY Works"
          },
          {
            "type": "TextBody",
            "text": "Own a home and stay rent-free for 3 years in prime Bangalore locations."
          },
          {
            "type": "TextBody",
            "markdown": true,
            "text": "✦ **Step 1: Pick Your Residence**\nChoose between exclusive 1, 2, or 3 BHK luxury residences.\n\n✦ **Step 2: 3 Years Rent-Free**\nMove in and live with zero monthly rent for 36 full months.\n\n✦ **Step 3: Pathway to Ownership**\nAfter 3 years, transition seamlessly into home ownership."
          },
          {
            "type": "EmbeddedLink",
            "text": "📄 Download Smart Stay Brochure (PDF)",
            "on-click-action": {
              "name": "open_url",
              "url": "/assets/smart-stay-brochure.pdf"
            }
          },
          {
            "type": "TextBody",
            "markdown": true,
            "text": "📞 **Need immediate assistance?**\nDirect Specialist Helpline: **+91 8147172449**"
          },
          {
            "type": "Footer",
            "label": "Check My Eligibility ➡️",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "RESERVATION_SCREEN"
              }
            }
          }
        ]
      }
    },
    {
      "id": "RESERVATION_SCREEN",
      "title": "Reserve Your Unit",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Lock In Your Smart Stay Unit"
          },
          {
            "type": "TextBody",
            "text": "Select your preference to reserve 1 of only 5 exclusive Bangalore units."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "bhk_type",
            "label": "Select Preferred Unit",
            "required": true,
            "data-source": [
              {
                "id": "1_bhk",
                "title": "1 BHK Luxury Unit"
              },
              {
                "id": "2_bhk",
                "title": "2 BHK Premium Unit"
              },
              {
                "id": "3_bhk",
                "title": "3 BHK Signature Unit"
              }
            ]
          },
          {
            "type": "RadioButtonsGroup",
            "name": "budget_range",
            "label": "Preferred Budget",
            "required": true,
            "data-source": [
              {
                "id": "budget_40_60",
                "title": "₹40 Lakhs - ₹60 Lakhs"
              },
              {
                "id": "budget_60_85",
                "title": "₹60 Lakhs - ₹85 Lakhs"
              },
              {
                "id": "budget_85_plus",
                "title": "₹85 Lakhs & Above"
              }
            ]
          },
          {
            "type": "Dropdown",
            "name": "call_slot",
            "label": "Preferred Call Slot",
            "required": true,
            "data-source": [
              {
                "id": "morning",
                "title": "Morning (10:00 AM - 1:00 PM)"
              },
              {
                "id": "afternoon",
                "title": "Afternoon (1:00 PM - 5:00 PM)"
              },
              {
                "id": "evening",
                "title": "Evening (5:00 PM - 8:00 PM)"
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "full_name",
            "label": "Your Full Name",
            "input-type": "text",
            "required": true,
            "helper-text": "Enter your name for priority allotment"
          },
          {
            "type": "TextInput",
            "name": "alternate_phone",
            "label": "Alternate Mobile (Optional)",
            "input-type": "text",
            "required": false,
            "helper-text": "In case WhatsApp is unreachable"
          },
          {
            "type": "Footer",
            "label": "Reserve My Offer",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "bhk_type": "${form.bhk_type}",
                "budget_range": "${form.budget_range}",
                "call_slot": "${form.call_slot}",
                "full_name": "${form.full_name}",
                "alternate_phone": "${form.alternate_phone}"
              }
            }
          }
        ]
      }
    }
  ]
}

