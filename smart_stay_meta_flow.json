{
  "version": "7.3",
  "screens": [
    {
      "id": "SMART_STAY_FORM",
      "title": "Smart Stay by IGH",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Reserve Your Smart Stay"
          },
          {
            "type": "TextBody",
            "text": "Own a home & stay rent-free for 3 years in Bangalore. Fill out the details below to lock your unit."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "bhk_type",
            "label": "Select Preferred Unit",
            "required": true,
            "data-source": [
              {
                "id": "1_bhk",
                "title": "1 BHK Luxury Unit"
              },
              {
                "id": "2_bhk",
                "title": "2 BHK Premium Unit"
              },
              {
                "id": "3_bhk",
                "title": "3 BHK Signature Unit"
              }
            ]
          },
          {
            "type": "RadioButtonsGroup",
            "name": "budget_range",
            "label": "Preferred Budget",
            "required": true,
            "data-source": [
              {
                "id": "budget_40_60",
                "title": "₹40 Lakhs - ₹60 Lakhs"
              },
              {
                "id": "budget_60_85",
                "title": "₹60 Lakhs - ₹85 Lakhs"
              },
              {
                "id": "budget_85_plus",
                "title": "₹85 Lakhs & Above"
              }
            ]
          },
          {
            "type": "Dropdown",
            "name": "call_slot",
            "label": "Preferred Call Slot",
            "required": true,
            "data-source": [
              {
                "id": "morning",
                "title": "Morning (10:00 AM - 1:00 PM)"
              },
              {
                "id": "afternoon",
                "title": "Afternoon (1:00 PM - 5:00 PM)"
              },
              {
                "id": "evening",
                "title": "Evening (5:00 PM - 8:00 PM)"
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "full_name",
            "label": "Your Full Name",
            "input-type": "text",
            "required": true,
            "helper-text": "Enter your name for reservation"
          },
          {
            "type": "TextInput",
            "name": "alternate_phone",
            "label": "Alternate Mobile (Optional)",
            "input-type": "text",
            "required": false,
            "helper-text": "In case WhatsApp is unreachable"
          },
          {
            "type": "Footer",
            "label": "Reserve My Offer",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "bhk_type": "${form.bhk_type}",
                "budget_range": "${form.budget_range}",
                "call_slot": "${form.call_slot}",
                "full_name": "${form.full_name}",
                "alternate_phone": "${form.alternate_phone}"
              }
            }
          }
        ]
      }
    }
  ]
}

